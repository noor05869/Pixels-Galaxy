# Public application settings
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_WHATSAPP_NUMBER=923000000000

# Supabase server credentials (never use the anon key here)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-supabase-secret-key

# Order notification email
RESEND_API_KEY=re_replace_me
ORDER_NOTIFICATION_EMAIL=orders@example.com
ORDER_FROM_EMAIL=Pixels Galaxy <orders@example.com>

# CloudFront/Amplify forwards the viewer address in this header
ORDER_CLIENT_IP_HEADER=x-forwarded-for
ADMIN_CLIENT_IP_HEADER=x-forwarded-for

# Admin authentication
ADMIN_PASSWORD_HASH=replace-with-generated-password-hash
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
